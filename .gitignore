# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
test-results.json
test-results.jsonl
lcov.info
/stats/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# Python and Kotlin build leftovers (scripts/, the Android build)
__pycache__/
*.pyc
.kotlin/

# The maintainer's brand material (logo variants, merch, Buy Me a Coffee covers) sits next to the
# tracked banner and screenshots but is not part of the repository; keep it out of a `git add -A`
assets/logo/
assets/merch/
assets/tee/
assets/bmc-cover*
# scripts/pdf/render-samples.mjs output (npm run pdf:check)
frontend/pdf-samples/

# Local Windows deployment (windows/Start-openGym.ps1): runtime, logs, generated state and the
# private CA storage stay on the machine. Only the scripts and docs are tracked.
windows/runtime/
windows/logs/
windows/caddy-storage/
windows/setup/
windows/firewall-enabled.txt
windows/processes.json
windows/access.json
windows/tailscale-*.json
start-api.log
web.log
web-error.log

# Generated by windows/Start-openGym.ps1 or specific to this machine (keep them out of clones)
windows/Caddyfile
windows/public-origin.txt
windows/Tailscale-remote-plan.md

# Personal Windows deployment docs and screenshots: the tracked general guide is
# windows/README.md; everything below is this machine's record and stays local.
windows/README-zh-CN.md
windows/INSTALLATION.json
windows/verification.json
windows/profile-verification.json
windows/*-preview.png
